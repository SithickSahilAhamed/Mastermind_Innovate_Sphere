rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Career applications: anyone can submit (public form, no login),
    // but nobody can read, edit, or delete from the client.
    // View submissions in the Firebase Console instead (admin access
    // bypasses these rules).
    match /careerApplications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
