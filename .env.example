## Firebase Web SDK config (Firestore only) — copy these into .env.local
## (and into your host's environment variables for production) with the
## real values from Firebase Console > Project settings > General >
## Your apps > SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

## Cloudinary (resume file storage) — free account at cloudinary.com.
## Cloud name is on your dashboard home. Create the preset under
## Settings > Upload > Upload presets > Add upload preset, with
## Signing Mode set to "Unsigned".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
